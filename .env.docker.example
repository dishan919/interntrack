# Copy to .env.docker; never commit the filled-in file.
# Generate a fresh local value and paste it here (do not use an example secret):
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Open this exact origin in the browser; no path or trailing slash here.
FRONTEND_PORT=8080
CLIENT_ORIGIN=http://localhost:8080
# Browser-visible, public Vite BUILD setting. /api goes through Nginx.
VITE_API_URL=/api
# Container DNS name, not localhost. Local-only MongoDB has no published host port.
MONGODB_URI=mongodb://mongo:27017/interntrack
